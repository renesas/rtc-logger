project('fsp', 'c')

fsp_mcu   = get_option('fsp_mcu')
fsp_board = get_option('fsp_board')

fsp_src = 'ra/fsp/src'

bsp_all  = fsp_src + '/bsp/mcu/all'
bsp_mcu  = fsp_src + '/bsp/mcu/' + fsp_mcu
board_dir = 'ra/board/' + fsp_board

# Select the generated sources based on MCU
comms_src_map = {
  'ra0e1': '/r_uarta/r_uarta.c',
  'ra4e2': '/r_sci_uart/r_sci_uart.c',
  'ra6e2': '/r_sci_uart/r_sci_uart.c',
  'ra6m4': '/r_sci_uart/r_sci_uart.c',
  'ra4m2': '/r_sci_uart/r_sci_uart.c',
  'ra8d1': '/r_sci_uart/r_sci_uart.c',
}

comms_ll_src = comms_src_map.get(fsp_mcu, '')
if comms_ll_src == ''
  error('Unsupported MCU for comms header mapping: ' + fsp_mcu)
endif

fsp_sources = files(
  # modules
  fsp_src + '/r_ioport/r_ioport.c',

  # BSP common
  bsp_all + '/bsp_clocks.c',
  bsp_all + '/bsp_common.c',
  bsp_all + '/bsp_delay.c',
  bsp_all + '/bsp_group_irq.c',
  bsp_all + '/bsp_guard.c',
  bsp_all + '/bsp_ipc.c',
  bsp_all + '/bsp_io.c',
  bsp_all + '/bsp_irq.c',
  bsp_all + '/bsp_macl.c',
  bsp_all + '/bsp_ospi_b.c',
  bsp_all + '/bsp_register_protection.c',
  bsp_all + '/bsp_sbrk.c',
  bsp_all + '/bsp_sdram.c',
  bsp_all + '/bsp_security.c',

  # MCU specific
  bsp_mcu + '/bsp_linker.c',

  # CMSIS device
  fsp_src + '/bsp/cmsis/Device/RENESAS/Source/startup.c',
  fsp_src + '/bsp/cmsis/Device/RENESAS/Source/system.c',

  # board
  board_dir + '/board_init.c',
  board_dir + '/board_leds.c',

  # HAL drivers — RTC, ICU (external interrupt), and UART
  fsp_src + '/r_rtc/r_rtc.c',
  fsp_src + '/r_icu/r_icu.c',
  fsp_src + comms_ll_src,

  # FreeRTOS port for RA (Cortex-M33)
  fsp_src + '/rm_freertos_port/port.c',

  # NOTE: FreeRTOS kernel sources are NOT in the FSP git repo.
  # They are generated by RASC into the projectdir at ra/aws/FreeRTOS/.
  # run_rasc.py copies them to firmware/generated/ra/aws/FreeRTOS/ at build time.
  # The firmware/meson.build adds them directly to the executable sources.

  # Middleware
  # NOTE: rm_comms_lock and rm_comms_uart were removed from FSP v6.5.0 src/.
  # The rm_comms_lock.h in src/ now contains a #error directing users to the
  # inc/instances version. These sources are no longer compiled separately.
  # fsp_src + '/rm_comms_lock/rm_comms_lock.c',  # removed in FSP v6.5.0
  # fsp_src + '/rm_comms_uart/rm_comms_uart.c',  # removed in FSP v6.5.0
)

fsp_inc = include_directories(
  'ra/fsp/inc',
  'ra/fsp/inc/api',
  'ra/fsp/inc/instances',
)

fsp_dep = declare_dependency(
  sources: fsp_sources,              # ✅ key difference
  include_directories: fsp_inc,
)

fsp_headers_dep = declare_dependency(
  include_directories: fsp_inc,
)