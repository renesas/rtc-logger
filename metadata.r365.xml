    <descriptiveMetadata>
        <anatomicalMetadata>
            <identity>
                <name>RTC Internal Timestamp Event Logger</name>
                <shortName>rs_rtc_logger</shortName>
                <category>Reference Software Component</category>
                <pesType>Runtime-oriented reference source code</pesType>
                <license>BSD-3-Clause</license>
            </identity>
            <description>
                <summary>Demonstrates timestamped serial event logging using the MCU on-chip RTC, a static circular buffer, and shared VCOM UART output through a vendored Buffered I/O UART driver.</summary>
                <designIntent>Capture RTC timestamps at ISR entry time without blocking the ISR, buffer events for task-context transmission, preserve RTC configuration and event sequence numbering across warm resets, and provide Example Project and Expert operating modes.</designIntent>
            </description>
            <classification>
                <domain>Embedded telemetry and event logging</domain>
                <technology>RTC, FreeRTOS, r_rtc, r_sci_uart, r_icu, Buffered I/O UART, VCOM</technology>
                <subCategory>RTC timestamped serial event logger</subCategory>
            </classification>
            <supportedBoards>
                <board>FPB-RA4E2</board>
                <board>FPB-RA6E2</board>
            </supportedBoards>
            <dependencies>
                <dependency>Renesas FSP v6.5.0</dependency>
                <dependency>FreeRTOS bundled with FSP v6.5.0</dependency>
                <dependency>e2studio compatible with FSP v6.5.0</dependency>
                <dependency>On-chip RTC HAL r_rtc</dependency>
                <dependency>SCI0 UART HAL r_sci_uart through g_uart_jlob_vcom</dependency>
                <dependency>External IRQ HAL r_icu for reference button event source</dependency>
                <dependency>Vendored Buffered I/O UART driver src/rs_stdio_uart_buffer_io/</dependency>
                <dependency>picolibc bundled with the LLVM ARM Embedded toolchain</dependency>
                <dependency>J-Link On-Board for FPB debug and flash</dependency>
                <dependency>Meson and LLVM/Clang for command-line host tests and firmware builds</dependency>
            </dependencies>
            <hardwareRequirements>
                <requirement>FPB-RA4E2 or FPB-RA6E2 reference board</requirement>
                <requirement>RA4E2 or RA6E2 Cortex-M33 MCU</requirement>
                <requirement>RTC clock source configured to LOCO by default</requirement>
                <requirement>r_rtc calendar mode enabled</requirement>
                <requirement>r_rtc Set Source Clock in Open disabled for warm-reset preservation</requirement>
                <requirement>r_rtc carry interrupt priority must be higher-preemption than any ISR that calls rs_rtc_logger_EventTrigger</requirement>
                <requirement>SCI0 shared VCOM UART at 115200 baud 8N1 through g_uart_jlob_vcom</requirement>
                <requirement>r_sci_uart asynchronous mode for the vendored Buffered I/O UART driver</requirement>
                <requirement>External IRQ r_icu for reference User Switch S1 event source</requirement>
                <requirement>FreeRTOS heap_4 or heap_3 and configSUPPORT_STATIC_ALLOCATION = 1</requirement>
                <requirement>FPB-RA4E2 has no VBATT power-down retention path</requirement>
            </hardwareRequirements>
            <artifacts>
