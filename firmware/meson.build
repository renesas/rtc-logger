# firmware/meson.build
#
# Builds two ELF targets per board:
#   rtc_event_logger_on_<board>_<compiler>.elf          — application firmware
#   rtc_event_logger_unittest_on_<board>_<compiler>.elf — Unity test firmware
#
# Supports: ra4e2-fpb (Cortex-M33) and ra6e2-fpb (Cortex-M33 + TrustZone)
 
fs = import('fs')

if not meson.is_cross_build()
  subdir_done()
endif

subdir('generated')

# Variables from firmware/generated/meson.build:
#   gen_board, board, mcu, ra_core, ra_ordinal, ldscript_opt
#   rasc_gen[], rasc_c_sources, rasc_headers_dep

# ── PES core sources (shared by both boards) ──────────────────────────────

rtc_core_sources = files(
  '../src/rs_rtc_logger/rs_rtc_logger.c',
  '../src/rs_rtc_logger/rs_rtc_logger_format.c',
  '../src/rs_rtc_logger/rs_rtc_logger_hal.c',
)

# UT build excludes rs_rtc_logger_hal.c — test_rs_rtc_logger_core.c provides
# mock HAL implementations that replace the real HAL for on-target testing.
rtc_core_sources_ut = files(
  '../src/rs_rtc_logger/rs_rtc_logger.c',
  '../src/rs_rtc_logger/rs_rtc_logger_format.c',
)

# Board-specific preset config — selected by mcu option
if mcu == 'ra6e2'
  board_config_src = files(
    '../src/rs_rtc_logger/config/rs_rtc_logger_data_fpb_ra6e2.c',
  )
else
  # ra4e2 (default)
  board_config_src = files(
    '../src/rs_rtc_logger/config/rs_rtc_logger_data_fpb_ra4e2.c',
  )
endif

# Board-specific application entry (blinky_thread_entry)
if mcu == 'ra6e2'
  app_entry_src = files('../src/blinky_thread_entry_ra6e2.c')
else
  app_entry_src = files('../src/blinky_thread_entry_ra4e2.c')
endif

# hal_entry.c — application entry hook declared in ra_gen/hal_data.h.
# FSP v6.5.0: no longer generated by RASC; owned by the project src/ tree.
hal_entry_src = files('../src/hal_entry.c')

# crt0_stub.c — weak _start stub to satisfy picolibc libc.a's reference to
# crt0.o. The FSP uses Reset_Handler as the true entry point; _start is never
# called. Without this stub, lld reports "cannot open crt0.o".
crt0_stub_src = files('../src/crt0_stub.c')

# Common application sources
app_common_src = files(
  '../src/fault_handler.c',
  # hal_warmstart.c is provided by RASC-generated rasc_core_sources[0].
  # Do NOT add src/hal_warmstart.c here — it would create a duplicate symbol.
  '../src/rs_rtc_logger_demo.c',
)


# FreeRTOS sources come from freertos_gen_src defined in firmware/generated/meson.build.
# They are custom_target outputs (renamed ra_freertos_*.c) so Meson treats them
# as generated files without setup-time existence validation.

# On-target Unity test sources (replace main.c + blinky_thread_entry)
test_sources = files(
  '../tests/test_main_firmware.c',
  '../tests/test_rs_rtc_logger_format.c',
  '../tests/test_rs_rtc_logger_core.c',
)

unity_target_port_src = files(
  '../tests/target/unity_port_sci_uart.c',
  '../tests/target/syscalls_sci_uart.c',
)

inc_dirs = [
  include_directories('../src'),
  include_directories('../tests'),
]

unity_target_cfg_inc = include_directories('../tests/target')

# ── Dependencies ──────────────────────────────────────────────────────────

unity_sp = subproject('unity', default_options: [
  'extension_fixture=true',
  'werror=false',
])

unity_src = unity_sp.get_variable('unity_src')
unity_dep = unity_sp.get_variable('unity_dep')
unity_inc = unity_sp.get_variable('unity_inc')

fsp_sp = subproject('fsp', default_options: [
  'fsp_mcu=' + mcu,
  'fsp_board=' + board,
])
fsp_dep = fsp_sp.get_variable('fsp_dep')

cmsis_sp = subproject('cmsis')
cmsis_dep = cmsis_sp.get_variable('cmsis_dep')

common_defines = [
  '-D_RENESAS_RA_',
  '-D_RA_CORE=' + ra_core,
  '-D_RA_ORDINAL=' + ra_ordinal.to_string(),
]

# Board-select macro for source files that must branch at compile time on
# target board (currently: src/rs_rtc_logger_demo.c, which picks between
# rs_rtc_logger_data_fpb_ra4e2.h and rs_rtc_logger_data_fpb_ra6e2.h).
# Mirrors the `mcu == 'ra6e2'` checks already used above for
# board_config_src / app_entry_src, so all three per-board selections in
# this file stay in sync with a single option (-Dmcu=ra4e2|ra6e2).
if mcu == 'ra6e2'
  common_defines += ['-DRS_RTC_LOGGER_TARGET_RA6E2=1']
else
  # ra4e2 (default)
  common_defines += ['-DRS_RTC_LOGGER_TARGET_RA4E2=1']
endif

# BSP_CFG_RTC_USED override (validation-test finding, RTC time-retention).
#
# ra_cfg/fsp_cfg/bsp/bsp_cfg.h is generated fresh into rasc_gen_base
# (the build directory, see below) every time the RASC-equivalent generation
# step runs for a board — it is NOT checked into this repo. If that
# generation step ever runs against a configuration.xml with the r_rtc
# *stack* removed (e.g. for the ConfigGen/ConfigCheck validation test),
# it emits `#define BSP_CFG_RTC_USED (RA_NOT_DEFINED)` instead of `(1)`.
#
# bsp_clocks.c gates an unconditional RTC peripheral reset on this exact
# flag (`#if !BSP_CFG_RTC_USED ... R_RTC->RCR2_b.RESET = 1; ...`), executed
# during SystemInit()/BSP startup — before main(), and long before this
# PES's own rs_rtc_logger_Open()/ConfigGen() ever run. With the flag at 0,
# the calendar counter is forced back to its epoch default (2000-01-01)
# on every single boot, cold or warm, regardless of anything ConfigGen()
# supplies — no PES-level code can prevent or undo a reset that already
# executed before it was called.
#
# bsp_cfg.h guards the RASC-generated value with #ifndef, so defining it
# here on the compiler command line takes precedence unconditionally,
# independent of whatever the r_rtc stack state happens to be in
# configuration.xml for either board. This must NOT be "fixed" by editing
# the generated bsp_cfg.h directly — rasc_gen_base lives in the build
# directory and is regenerated, so any hand-edit there is silently lost on
# the next `meson setup`/regeneration.
common_defines += ['-DBSP_CFG_RTC_USED=1']

cc = meson.get_compiler('c')
compiler_id = cc.get_id()

project_name     = meson.project_name()
firmware_name    = project_name + '_on_' + board + '_' + compiler_id
firmware_ut_name = project_name + '_unittest_on_' + board + '_' + compiler_id

# ── Split RASC generated sources ─────────────────────────────────────────
# rasc_gen[6] = main.c — replaced in UT build by test_main_firmware.c

# FSP v6.5.0 rasc_gen indices (hal_entry.c removed, see firmware/generated/meson.build)
# [0]=hal_warmstart.c [1]=common_data.c [2]=common_data.h [3]=hal_data.c
# [4]=hal_data.h [5]=main.c [6]=pin_data.c [7]=vector_data.c [8]=vector_data.h
rasc_core_sources = [
  rasc_gen[0],   # hal_warmstart.c
  rasc_gen[1],   # common_data.c
  rasc_gen[3],   # hal_data.c
  rasc_gen[6],   # pin_data.c
  rasc_gen[7],   # vector_data.c
  rasc_gen[29],  # blinky_thread.c (RASC-generated FreeRTOS thread glue)
]

rasc_generated_main = rasc_gen[5]   # main.c (app build only)

# ── Linker script selection ───────────────────────────────────────────────

script_dir = join_paths(meson.current_build_dir(), 'generated')

# Include paths for RASC-generated subdirectories.
# These cannot use include_directories() because the dirs are created by RASC
# at compile time (after setup). Passed as -I c_args directly on executables.
rasc_gen_base = join_paths(meson.current_build_dir(), 'generated')
rasc_gen_c_args = [
  '-I' + rasc_gen_base + '/ra_cfg/fsp_cfg',
  '-I' + rasc_gen_base + '/ra_cfg/fsp_cfg/bsp',
  '-I' + rasc_gen_base + '/ra_cfg/aws',
  '-I' + rasc_gen_base + '/ra_gen',
  '-I' + rasc_gen_base + '/ra/aws/FreeRTOS/FreeRTOS/Source/include',
  '-I' + rasc_gen_base + '/ra/fsp/src/rm_freertos_port',
]

map_file_app = join_paths(meson.current_build_dir(), firmware_name    + '.map')
map_file_ut  = join_paths(meson.current_build_dir(), firmware_ut_name + '.map')

link_args_common = []

if compiler_id == 'clang'
  script = join_paths(script_dir, 'fsp.lld')
  link_args_common += [
    '-T' + script,
    '-Wl,-L' + script_dir,
    '-Wl,-eReset_Handler',
  ]
elif compiler_id == 'gcc'
  script = join_paths(script_dir, 'gnu', 'fsp.ld')
  link_args_common += [
    '-T' + script,
    '-Wl,-L' + script_dir,
    '-Wl,-eReset_Handler',
  ]
elif compiler_id == 'armclang'
  script = join_paths(script_dir, 'keil', 'fsp.sct')
  link_args_common += [
    '--scatter=' + script,
    '--map',
  ]
elif compiler_id == 'iar'
  script = join_paths(script_dir, 'iar', 'fsp.icf')
  link_args_common += [
    '--config=' + script,
  ]
else
  error('Unsupported compiler: ' + compiler_id)
endif

link_args_app = link_args_common + ['-Wl,-Map=' + map_file_app]
link_args_ut  = link_args_common + ['-Wl,-Map=' + map_file_ut]

# ── Application firmware ELF ──────────────────────────────────────────────

firmware_elf = executable(
  firmware_name + '.elf',
  native: false,
  sources: hal_entry_src
           + crt0_stub_src
           + rasc_core_sources
           + [rasc_generated_main]
           + rtc_core_sources
           + board_config_src
           + app_entry_src
           + app_common_src
           + freertos_gen_src,
  include_directories: inc_dirs,
  c_args: common_defines + rasc_gen_c_args,
  link_args: link_args_app,
  dependencies: [
    fsp_dep,
    cmsis_dep,
    rasc_headers_dep,
  ],
  install: false,
)

# ── Unity-on-target firmware ELF ─────────────────────────────────────────
# rs_rtc_logger_hal.c IS included here (on-target, real HAL is available).
# test_rs_rtc_logger_core.c provides mock HAL only for the HOST build;
# on target, the mock functions are #ifdef-guarded out and the real HAL links.
#
# rasc_gen[1] (hal_warmstart.c) is included in rasc_core_sources above.
# The standalone src/hal_warmstart.c is NOT added again to avoid duplicate
# symbol — the RASC-generated version is used for firmware builds.

firmware_ut_elf = executable(
  firmware_ut_name + '.elf',
  native: false,
  sources: hal_entry_src
           + crt0_stub_src
           + rasc_core_sources
           + rtc_core_sources_ut
           + board_config_src
           + app_common_src
           + freertos_gen_src
           + test_sources
           + unity_src
           + unity_target_port_src,
  include_directories: inc_dirs + [
    unity_inc,
    unity_target_cfg_inc,
  ],
  c_args: common_defines + rasc_gen_c_args + [
    '-DUNITY_INCLUDE_CONFIG_H',
    '-DUNITY_FIXTURE_NO_EXTRAS',
  ],
  link_args: link_args_ut + ['-lc'],
  dependencies: [
    fsp_dep,
    cmsis_dep,
    rasc_headers_dep,
  ],
  install: false,
)

# ── Objcopy / SREC ────────────────────────────────────────────────────────

if compiler_id == 'clang'
  objcopy          = find_program('llvm-objcopy')
  objcopy_cmd      = [objcopy, '-O', 'srec', '@INPUT@', '@OUTPUT@']
  rasc_compiler_id = 'LLVMARM'
elif compiler_id == 'gcc'
  objcopy          = find_program('arm-none-eabi-objcopy')
  objcopy_cmd      = [objcopy, '-O', 'srec', '@INPUT@', '@OUTPUT@']
  rasc_compiler_id = 'GCC'
elif compiler_id == 'armclang'
  objcopy          = find_program('fromelf')
  objcopy_cmd      = [objcopy, '--srec', '--output', '@OUTPUT@', '@INPUT@']
  rasc_compiler_id = 'ARMv6'
elif compiler_id == 'iar'
  objcopy          = find_program('ielftool')
  objcopy_cmd      = [objcopy, '--srec', '@INPUT@', '@OUTPUT@']
  rasc_compiler_id = 'IAR'
else
  error('Unsupported toolchain for SREC')
endif

firmware_srec = custom_target(
  'srec_' + firmware_name,
  input: firmware_elf,
  output: firmware_name + '.srec',
  command: objcopy_cmd,
  build_by_default: true,
  install: true,
  install_dir: 'firmware/' + gen_board,
)

firmware_ut_srec = custom_target(
  'srec_' + firmware_ut_name,
  input: firmware_ut_elf,
  output: firmware_ut_name + '.srec',
  command: objcopy_cmd,
  build_by_default: true,
  install: true,
  install_dir: 'firmware/' + gen_board,
)

device = get_option('device')

# ── Smart bundle (TrustZone MCUs: RA4M2, RA6M4, RA8D1) ───────────────────
# RA4E2 and RA6E2 use flat-memory programming — no bundle needed.

needs_bundle = mcu in ['ra4m2', 'ra6m4', 'ra8d1']

if needs_bundle
  py_prog  = find_program('python3', required: true)
  rasc_prog = find_program('rasc', required: true)
  run_rasc_bundle_py = join_paths(meson.project_source_root(), 'scripts', 'run_rasc_bundle.py')
  config_xml_abs     = join_paths(meson.project_source_root(), 'firmware', gen_board, 'configuration.xml')

  rasc_bundle_app = custom_target(
    'rasc_bundle_' + firmware_name,
    input: firmware_elf,
    output: [firmware_name + '.rpd', firmware_name + '.sbd'],
    command: [
      py_prog, run_rasc_bundle_py,
      '--rasc', rasc_prog,
      '--config', config_xml_abs,
      '--elf', '@INPUT@',
      '--compiler', rasc_compiler_id,
      '--devicefamily', 'ra',
      '--outdir', '@OUTDIR@',
      '--rpd-name', firmware_name + '.rpd',
      '--sbd-name', firmware_name + '.sbd',
    ],
    depend_files: run_rasc_bundle_py,
    build_by_default: true,
  )

  rasc_bundle_ut = custom_target(
    'rasc_bundle_' + firmware_ut_name,
    input: firmware_ut_elf,
    output: [firmware_ut_name + '.rpd', firmware_ut_name + '.sbd'],
    command: [
      py_prog, run_rasc_bundle_py,
      '--rasc', rasc_prog,
      '--config', config_xml_abs,
      '--elf', '@INPUT@',
      '--compiler', rasc_compiler_id,
      '--devicefamily', 'ra',
      '--outdir', '@OUTDIR@',
      '--rpd-name', firmware_ut_name + '.rpd',
      '--sbd-name', firmware_ut_name + '.sbd',
    ],
    depend_files: run_rasc_bundle_py,
    build_by_default: true,
  )
endif

# ── RFP flash programmer targets ──────────────────────────────────────────
# rfp-cli.exe is only needed for the rfp_program / rfp_reset flash targets.
# required: false allows 'meson setup' and 'meson compile' to succeed even
# when Renesas Flash Programmer is not installed.  The flash targets will
# simply fail at run time if rfp-cli.exe is absent.

rfp_cli = find_program('rfp-cli.exe', required: false)

if rfp_cli.found()

if needs_bundle
  run_target(
    'rfp_program',
    command: [
      rfp_cli, '-d', 'RA', '-t', 'jlink', '-if', 'swd',
      '-fo', 'boundary-file', rasc_bundle_app[0],
      '-file', firmware_srec[0], '-auto', '-run',
    ],
  )
  run_target(
    'rfp_program_ut',
    command: [
      rfp_cli, '-d', 'RA', '-t', 'jlink', '-if', 'swd',
      '-fo', 'boundary-file', rasc_bundle_ut[0],
      '-file', firmware_ut_srec[0], '-auto', '-run',
    ],
  )
else
  # RA4E2 / RA6E2 — flat programming (no TrustZone boundary file needed)
  run_target(
    'rfp_program',
    command: [
      rfp_cli, '-d', 'RA', '-t', 'jlink', '-if', 'swd',
      '-file', firmware_srec[0], '-auto', '-run',
    ],
  )
  run_target(
    'rfp_program_ut',
    command: [
      rfp_cli, '-d', 'RA', '-t', 'jlink', '-if', 'swd',
      '-file', firmware_ut_srec[0], '-auto', '-run',
    ],
  )
endif

run_target('rfp_reset',
  command: [rfp_cli, '-d', 'RA', '-t', 'jlink', '-if', 'swd', '-reset'])

run_target('rfp_erase_halt',
  command: [rfp_cli, '-d', 'RA', '-t', 'jlink', '-if', 'swd', '-erase', '-halt'])

run_target('rfp_check_blank',
  command: [rfp_cli, '-d', 'RA', '-t', 'jlink', '-if', 'swd', '-blankcheck'])

endif # rfp_cli.found()
