# firmware/generated/meson.build
#
# Runs RASC headless to generate ra_gen / ra_cfg output for the selected board,
# then copies the required files into the Meson build directory so that
# subsequent firmware targets can depend on them as generated sources.

if not meson.is_cross_build()
  subdir_done()
endif

py   = find_program('python3',   required: true)
rasc = find_program('rasc', required: true)

gen_board   = get_option('gen_board')
board       = get_option('board')
mcu         = get_option('mcu')
ra_core     = get_option('ra_core')
ra_ordinal  = get_option('ra_ordinal')
ldscript_opt = get_option('ldscript')

config_xml  = join_paths(meson.project_source_root(), 'firmware', gen_board, 'configuration.xml')
run_rasc_py = join_paths(meson.project_source_root(), 'scripts', 'run_rasc.py')

# UART config header varies by MCU family
comms_cfg_header_map = {
  'ra4e2': 'r_sci_uart_cfg.h',
  'ra6e2': 'r_sci_uart_cfg.h',
  'ra4m2': 'r_sci_uart_cfg.h',
  'ra6m4': 'r_sci_uart_cfg.h',
  'ra8d1': 'r_sci_uart_cfg.h',
  'ra0e1': 'r_uarta_cfg.h',
}

comms_ll_cfg_header = comms_cfg_header_map.get(mcu, '')
if comms_ll_cfg_header == ''
  error('Unsupported MCU for comms header mapping: ' + mcu)
endif

# ── RASC-generated output list ────────────────────────────────────────────
# Update this list to match what run_rasc.py copies from the RASC projectdir.

# FSP v6.5.0: hal_entry.c is no longer generated by RASC.
# It is provided by the project src/ directory (src/hal_entry.c).
# Index comments updated accordingly.
rasc_outputs = [
  'hal_warmstart.c',    # [0]

  'common_data.c',      # [1]
  'common_data.h',      # [2]
  'hal_data.c',         # [3]
  'hal_data.h',         # [4]
  'main.c',             # [5]
  'pin_data.c',         # [6]
  'vector_data.c',      # [7]
  'vector_data.h',      # [8]
  'bsp_clock_cfg.h',    # [9]

  'r_ioport_cfg.h',     # [10]
  comms_ll_cfg_header,  # [11]  e.g. r_sci_uart_cfg.h

  'board_cfg.h',        # [12]
  'bsp_cfg.h',          # [13]
  'bsp_linker_info.h',  # [14]
  'bsp_mcu_device_cfg.h',    # [15]
  'bsp_mcu_device_pn_cfg.h', # [16]
  'bsp_mcu_family_cfg.h',    # [17]
  'bsp_mcu_ofs_cfg.h',       # [18]
  'bsp_pin_cfg.h',           # [19]

  'fsp_gen.lld',        # [20]
  'memory_regions.lld', # [21]
  'fsp.lld',            # [22]

  # FreeRTOS kernel sources — RASC copies these to the outdir via run_rasc.py.
  # Declared as custom_target outputs so Meson treats them as generated files
  # and does not validate their existence at setup time.
  'ra_freertos_tasks.c',        # [23]
  'ra_freertos_queue.c',        # [24]
  'ra_freertos_list.c',         # [25]
  'ra_freertos_timers.c',       # [26]
  'ra_freertos_event_groups.c', # [27]
  'ra_freertos_stream_buffer.c',# [28]

  # ra_gen thread sources — RASC generates thread .c files for each FreeRTOS thread
  'blinky_thread.c',  # [29]
]

rasc_gen = custom_target(
  'generate_rasc_' + gen_board,
  input: config_xml,
  output: rasc_outputs,
  command: [
    py,
    run_rasc_py,
    '--rasc', rasc,
    '--config', '@INPUT@',
    '--outdir', '@OUTDIR@',
    '--projectdir', '@PRIVATE_DIR@',
    '--comms-ll-cfg-header', comms_ll_cfg_header,
  ],
  depend_files: run_rasc_py,
  build_by_default: false,
)

# ── Convenience sub-lists referenced by firmware/meson.build ─────────────

# hal_entry.c is no longer in rasc_gen[] — it comes from src/ directly.
rasc_c_sources = [
  rasc_gen[0],   # hal_warmstart.c
  rasc_gen[1],   # common_data.c
  rasc_gen[3],   # hal_data.c
  rasc_gen[5],   # main.c
  rasc_gen[6],   # pin_data.c
  rasc_gen[7],   # vector_data.c
  rasc_gen[29],  # blinky_thread.c
]

# FreeRTOS kernel sources as custom_target outputs
freertos_gen_src = [
  rasc_gen[23],  # tasks.c
  rasc_gen[24],  # queue.c
  rasc_gen[25],  # list.c
  rasc_gen[26],  # timers.c
  rasc_gen[27],  # event_groups.c
  rasc_gen[28],  # stream_buffer.c
]

# rasc_headers_dep exposes the flat generated directory (board_cfg.h etc.).
# Additional RASC-generated subdirectory include paths are passed as -I c_args
# on the firmware executables in firmware/meson.build, because Meson validates
# include_directories() paths at setup time before RASC has run to create them.
rasc_gen_inc = []   # populated via rasc_gen_c_args in firmware/meson.build

rasc_headers_dep = declare_dependency(
  include_directories: include_directories('.'),
  sources: [
    rasc_gen[2],   # common_data.h
    rasc_gen[4],   # hal_data.h
    rasc_gen[8],   # vector_data.h
    rasc_gen[9],   # bsp_clock_cfg.h
    rasc_gen[10],  # r_ioport_cfg.h
    rasc_gen[11],  # r_sci_uart_cfg.h / r_uarta_cfg.h
    rasc_gen[12],  # board_cfg.h
    rasc_gen[13],  # bsp_cfg.h
    rasc_gen[14],  # bsp_linker_info.h
    rasc_gen[15],  # bsp_mcu_device_cfg.h
    rasc_gen[16],  # bsp_mcu_device_pn_cfg.h
    rasc_gen[17],  # bsp_mcu_family_cfg.h
    rasc_gen[18],  # bsp_mcu_ofs_cfg.h
    rasc_gen[19],  # bsp_pin_cfg.h
  ],
)

# ── Manual re-run target (useful during development) ─────────────────────

run_target(
  'rasc_generate',
  command: [
    py,
    run_rasc_py,
    '--rasc', rasc,
    '--config', config_xml,
    '--outdir', meson.current_build_dir(),
    '--projectdir', join_paths(meson.current_build_dir(), 'rasc_manual'),
    '--comms-ll-cfg-header', comms_ll_cfg_header,
  ],
)
